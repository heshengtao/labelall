{
  "name": "labelall",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "description": "Cross-platform desktop & web tool for loading, viewing and annotating common image datasets (COCO, YOLO, Pascal VOC, ImageFolder).",
  "license": "Apache-2.0",
  "author": "heshengtao",
  "repository": {
    "type": "git",
    "url": "https://github.com/heshengtao/labelall.git"
  },
  "homepage": "https://github.com/heshengtao/labelall#readme",
  "bugs": {
    "url": "https://github.com/heshengtao/labelall/issues"
  },
  "keywords": [
    "annotation",
    "image-annotation",
    "labeling-tool",
    "dataset",
    "coco",
    "yolo",
    "pascal-voc",
    "imagenet",
    "tauri",
    "computer-vision"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.14.0",
    "@mui/x-tree-view": "^9.14.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "fast-xml-parser": "^5.11.2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.18",
    "konva": "^10.7.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-konva": "^19.3.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
