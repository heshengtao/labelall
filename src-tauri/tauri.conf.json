{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LableAll",
  "version": "0.1.0",
  "identifier": "io.github.heshengtao.lableall",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LableAll",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Load, view and annotate common image datasets",
    "longDescription": "LableAll is a cross-platform desktop and web tool for loading, viewing and annotating common image dataset formats such as COCO, YOLO, Pascal VOC and ImageFolder/ImageNet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
